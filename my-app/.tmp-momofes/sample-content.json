        "indent": 0,
        "version": 1,
        "children": [
          {
            "mode": "normal",
            "text": "NPO法人はなとたねでは、夏休み限定の体験型プログラム「2026たねラボ サマースクール」を開催します。",
            "type": "text",
            "style": "",
            "detail": 0,
            "format": 0,
            "version": 1
